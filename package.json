{
  "name": "n8n-nodes-warmbly",
  "version": "0.1.0",
  "description": "n8n community node for Warmbly: cold email, mailbox warmup, unibox, CRM, deliverability and webhooks. Self-hostable.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "warmbly",
    "cold-email",
    "email-warmup",
    "deliverability",
    "outreach",
    "crm",
    "unibox",
    "smtp"
  ],
  "license": "MIT",
  "homepage": "https://warmbly.com",
  "author": {
    "name": "Warmbly",
    "email": "support@warmbly.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warmbly/n8n-nodes-warmbly.git"
  },
  "bugs": {
    "url": "https://github.com/warmbly/n8n-nodes-warmbly/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WarmblyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Warmbly/Warmbly.node.js",
      "dist/nodes/Warmbly/WarmblyTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
